/* 
    500ms
*/
void LED1_Task (uint8_t step)
{
    PORTB.0 = ~PORTB.0;  // Toggle LED 1 (PB0)    
}


/*
   3steps*100ms
   1steps*1000ms 
*/
void LED2_Task (uint8_t step)
{
    static uint8_t cntOfRun = 0;
    
    switch (step)
    {
        case 0:
        {
            PORTB.1 = ~PORTB.1;  // Toggle LED 2 (PB1)
            cntOfRun++;
            if (cntOfRun == 3)
            {
                cntOfRun = 0; 
                Task_ChangeStep (1, 1);  
                Task_ChangeTime (1, 1000);
            }
        }break;
        
        case 1:
        {
            PORTB.1 = ~PORTB.1;  // Toggle LED 2 (PB1)
            Task_ChangeStep (1, 0);  
            Task_ChangeTime (1, 100);
        }break;           
    }
}